# GEOMATIK — variables d'environnement
# Copier ce fichier en .env.local et remplir les vraies valeurs.
# .env.local est gitignoré et NE DOIT JAMAIS être commité.

# ════════════════════════════════════════════════════════════════════
# OBLIGATOIRE
# ════════════════════════════════════════════════════════════════════

# ─── Supabase ────────────────────────────────────────────────────────
# Dashboard Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Service role : NEVER expose côté client. Server-side uniquement.
# Dashboard Supabase → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ─── LLM (GeoAgent + chat copilote) ──────────────────────────────────
# Free tier : 60 req/min, 1500 req/jour, 1M tokens/min
# https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...

# ─── Modal (Custom Bidding ML) ───────────────────────────────────────
# Préfixe commun aux 3 endpoints Modal (predict / train / detect-drift)
# Le client TS ajoute -predict.modal.run, etc.
# Récupéré après `modal deploy modal/bidding_ml/app.py`
MODAL_BIDDING_ML_URL=https://<workspace>--bidding-ml

# ════════════════════════════════════════════════════════════════════
# OPTIONNEL — features avancées
# ════════════════════════════════════════════════════════════════════

# ─── DB direct (scripts admin) ───────────────────────────────────────
# Connection string PostgreSQL direct (port 5432). URL-encoder le password
# si caractères spéciaux : @=%40 #=%23 &=%26 /=%2F * ] [
# Dashboard Supabase → Settings → Database → Connection string → URI
# DATABASE_URL=postgresql://postgres:PWD@db.<ref>.supabase.co:5432/postgres
# SUPABASE_DB_URL=postgresql://...

# ─── Mistral (fallback LLM) ──────────────────────────────────────────
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# ─── OpenRouteService (isochrones) ───────────────────────────────────
# Sans cette clé, les fonctions isochrones sont désactivées.
# https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# ─── Modal CLI (déploiement) ─────────────────────────────────────────
# Pas utilisés à runtime, juste pour `modal token set --token-id ... --token-secret ...`
# https://modal.com/settings/tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ─── Upstash Redis (rate limiting prod) ──────────────────────────────
# Sans ces vars : fallback rate limiter in-memory (OK en dev, pas en prod multi-instance).
# https://console.upstash.com → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Google Maps (Maps Embed dans l'app) ─────────────────────────────
# Clé publique restreinte à Maps Embed API uniquement (NE PAS réutiliser Gemini)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── PMTiles via GitHub Releases (si dépôt privé) ────────────────────
# scope 'repo' nécessaire pour le proxy
GITHUB_TOKEN=

# ─── Admin init (premier setup) ──────────────────────────────────────
# Clé secrète pour l'endpoint /api/admin/init-admin (création du premier user admin)
# À supprimer après le bootstrap initial
ADMIN_INIT_KEY=

# ─── Inngest (background jobs) ───────────────────────────────────────
# Si non configurés, les jobs Inngest tombent en mode dev local
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Configuration runtime ───────────────────────────────────────────
# URL publique de l'app (utilisée dans certains liens internes serveur → Modal etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Python path (scripts/benchmarking, optionnel) ───────────────────
# Si tu lances les scripts Python de benchmarking, peut être nécessaire sur Windows
# PYTHON_PATH=C:\Users\<you>\AppData\Local\...\python.exe
