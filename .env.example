# MAGELIAN — variables d'environnement
# Copier ce fichier en .env.local et remplir les vraies valeurs.
# .env.local est gitignoré et NE DOIT JAMAIS être commité.

# ════════════════════════════════════════════════════════════════════
# OBLIGATOIRE
# ════════════════════════════════════════════════════════════════════

# ─── Supabase ────────────────────────────────────────────────────────
# Dashboard Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Service role : NEVER expose côté client. Server-side uniquement.
# Dashboard Supabase → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Alias server-side de la clé anon. Optionnel : lib/auth.ts retombe sur
# NEXT_PUBLIC_SUPABASE_ANON_KEY si absent. Utile pour éviter d'exposer une
# clé via le bundle client dans certains contextes serveur.
SUPABASE_ANON_KEY=

# ─── Chiffrement des secrets DSP ─────────────────────────────────────
# OBLIGATOIRE dès que l'onglet « API connexions » est utilisé : chiffre en
# AES-256-GCM les credentials DSP stockés dans la table dsp_connections.
# Doit faire exactement 32 bytes encodés en base64. NE JAMAIS exposer au client.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DSP_ENC_KEY=

# ─── LLM (GeoAgent + chat copilote) ──────────────────────────────────
# Free tier : 60 req/min, 1500 req/jour, 1M tokens/min
# https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSy...

# ─── Modal (Custom Bidding ML) ───────────────────────────────────────
# Préfixe commun aux 3 endpoints Modal (predict / train / detect-drift)
# Le client TS ajoute -predict.modal.run, etc.
# Récupéré après `modal deploy modal/bidding_ml/app.py`
MODAL_BIDDING_ML_URL=https://<workspace>--bidding-ml

# ════════════════════════════════════════════════════════════════════
# OPTIONNEL — features avancées
# ════════════════════════════════════════════════════════════════════

# ─── DB direct (scripts admin) ───────────────────────────────────────
# Connection string PostgreSQL direct (port 5432). URL-encoder le password
# si caractères spéciaux : @=%40 #=%23 &=%26 /=%2F * ] [
# Dashboard Supabase → Settings → Database → Connection string → URI
# Les scripts (populate_carreaux_1km, populate_geom_3857) lisent dans l'ordre :
# SUPABASE_DB_URL → DATABASE_URL → POSTGRES_URL. Un seul suffit.
# DATABASE_URL=postgresql://postgres:PWD@db.<ref>.supabase.co:5432/postgres
# SUPABASE_DB_URL=postgresql://...
# POSTGRES_URL=postgresql://...

# ─── Mistral (fallback LLM) ──────────────────────────────────────────
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# ─── OpenRouteService (isochrones) ───────────────────────────────────
# Sans cette clé, les fonctions isochrones sont désactivées.
# https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# ─── Modal CLI (déploiement) ─────────────────────────────────────────
# Pas utilisés à runtime, juste pour `modal token set --token-id ... --token-secret ...`
# https://modal.com/settings/tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ─── Upstash Redis (rate limiting prod) ──────────────────────────────
# Sans ces vars : fallback rate limiter in-memory (OK en dev, pas en prod multi-instance).
# https://console.upstash.com → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Google Maps (Maps Embed dans l'app) ─────────────────────────────
# Clé publique restreinte à Maps Embed API uniquement (NE PAS réutiliser Gemini)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── PMTiles via GitHub Releases (si dépôt privé) ────────────────────
# scope 'repo' nécessaire pour le proxy
GITHUB_TOKEN=

# Déclenchement du workflow de génération des PMTiles IRIS
# (/api/admin/trigger-pmtiles). Sans ces deux vars, la route est inopérante.
# GITHUB_ACTIONS_TOKEN : PAT avec scope 'workflow'
# GITHUB_REPO          : format "owner/repo"
GITHUB_ACTIONS_TOKEN=
GITHUB_REPO=

# ─── Connexions DSP — DV360 (OAuth Google) ───────────────────────────
# Fallback serveur : si une organisation saisit son propre client OAuth dans
# l'UI, les valeurs en base priment sur ces variables.
# Console Google Cloud → API & Services → Credentials → OAuth 2.0 Client ID
DV360_OAUTH_CLIENT_ID=
DV360_OAUTH_CLIENT_SECRET=
# Optionnel : si absent, dérivé de NEXT_PUBLIC_APP_URL
# + /api/admin/dsp/dv360/oauth/callback
DV360_OAUTH_REDIRECT_URI=

# ─── Connexions DSP — TikTok Business API ────────────────────────────
# Même logique de fallback que DV360 (la saisie par org prime).
# TikTok for Business → Developers → My Apps
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# Optionnel : si absent, dérivé de NEXT_PUBLIC_APP_URL
# + /api/admin/dsp/tiktok/oauth/callback
TIKTOK_OAUTH_REDIRECT_URI=

# ─── Admin init (premier setup) ──────────────────────────────────────
# Clé secrète pour l'endpoint /api/admin/init-admin (création du premier user admin)
# À supprimer après le bootstrap initial
ADMIN_INIT_KEY=

# ─── Inngest (background jobs) ───────────────────────────────────────
# Si non configurés, les jobs Inngest tombent en mode dev local
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Atmo Data (santé environnementale : qualité air ATMO + pollen) ──
# Provider de données :
#   - 'mock' (défaut) : payload déterministe pour dev/test sans creds
#   - 'atmofrance'    : Atmo Data v2 — requiert un compte gratuit
#                       https://admindata.atmo-france.org/inscription-api
ATMO_PROVIDER=mock
ATMO_FRANCE_USERNAME=
ATMO_FRANCE_PASSWORD=

# Overrides d'URL — laisser vides sauf si les endpoints Atmo changent.
# ATMO_WFS_URL : GeoServer WFS public, source PRIMAIRE de l'ingestion pollen
#                et qualité de l'air nationale. Ne requiert AUCUN credential.
#                Défaut : https://data.atmo-france.org/geoserver/ows
# ATMO_API_URL : API Atmo Data v2 (requiert un compte), utilisée seulement
#                quand ATMO_PROVIDER=atmofrance.
#                Défaut : https://admindata.atmo-france.org
ATMO_WFS_URL=
ATMO_API_URL=

# ─── Configuration runtime ───────────────────────────────────────────
# URL publique de l'app (utilisée dans certains liens internes serveur → Modal etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Python path (scripts/benchmarking, optionnel) ───────────────────
# Si tu lances les scripts Python de benchmarking, peut être nécessaire sur Windows
# PYTHON_PATH=C:\Users\<you>\AppData\Local\...\python.exe
