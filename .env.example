# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# PostgreSQL direct connection (used by health check + data scripts)
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── IA / LLM ──────────────────────────────────────────────────────────────────
# Gemini — provider par défaut (Gemini 2.5 Flash)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Mistral — provider alternatif (Mistral Small)
# Get from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your-mistral-api-key

# ── Isochrones ────────────────────────────────────────────────────────────────
# OpenRouteService — calcul d'isochrones (pied / vélo / voiture)
# Get from: https://openrouteservice.org/dev/#/login → Dashboard → Tokens
ORS_API_KEY=your-ors-api-key

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Upstash Redis — rate limiting multi-instance (prod Vercel)
# Sans ces vars : fallback in-memory (dev uniquement)
# Créer une DB gratuite sur https://console.upstash.com → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Administration ────────────────────────────────────────────────────────────
# Clé secrète pour la route /api/admin/init-admin (bootstrap premier admin)
ADMIN_INIT_KEY=your-secret-admin-init-key

# ── CI/CD — PMTiles ───────────────────────────────────────────────────────────
# Token GitHub pour déclencher le workflow de génération PMTiles IRIS
# Optionnel — nécessaire uniquement si vous utilisez /admin/sources → "Générer PMTiles"
GITHUB_ACTIONS_TOKEN=your-github-personal-access-token
GITHUB_REPO=owner/repo

# ── Application ───────────────────────────────────────────────────────────────
# URL publique de l'app (utilisée par les outils IA pour les appels internes)
# En production : https://your-app.vercel.app
# En dev : http://localhost:3000 (valeur par défaut si absent)
NEXT_PUBLIC_APP_URL=http://localhost:3000
