# Service d'optimisation (Python) — NOMS des variables seulement.
# Copier en services/optimisation/.env (ignoré par git) et remplir.
# Rôle de chacune : ARCHITECTURE.md § « Variables d'environnement » > « Service d'optimisation ».

# Rôle Postgres optimisation_service (sql/342). Depuis le conteneur : hôte supabase_db_genesis_app, port 5432.
OPTIMISATION_DATABASE_URL=
# Clé de la passerelle Next -> Python (en-tête X-Optimisation-Cle).
OPTIMISATION_CLE_INTERNE=
# Clé AES-256-GCM des secrets DSP (même valeur que .env.local) — utilisée à partir de T13.
DSP_ENC_KEY=
# Client OAuth DV360 de secours — utilisé à partir de T14.
DV360_OAUTH_CLIENT_ID=
DV360_OAUTH_CLIENT_SECRET=
# Heure du passage quotidien (HH:MM) — utilisée à partir de T11.
OPTIMISATION_HEURE_CYCLE=
# Fuseau du jour d'un cycle (Europe/Paris).
TZ=
